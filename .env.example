# ============================================================
# SALIN file ini menjadi .env lalu isi nilai-nya
# ============================================================

# Data login
LOGIN_URL=https://example.com/login
USERNAME=email_atau_user_anda
PASSWORD=password_anda

# Selector halaman login (sesuaikan dengan situs target)
SELECTOR_USERNAME=#username
SELECTOR_PASSWORD=#password
SELECTOR_SUBMIT=button[type=submit]

# Provider captcha solver: "2captcha" atau "anticaptcha"
CAPTCHA_PROVIDER=2captcha
# API key dari layanan solver (daftar di 2captcha.com / anti-captcha.com)
CAPTCHA_API_KEY=isi_api_key_anda

# Jenis captcha yang muncul di halaman: "recaptcha" | "hcaptcha" | "none"
CAPTCHA_TYPE=recaptcha

# (Opsional) situs key captcha kalau tidak bisa dideteksi otomatis
# CAPTCHA_SITEKEY=

# Path profil browser agar tetap "login" di sesi berikutnya
USER_DATA_DIR=./browser_profile
# Kalau true, hapus profil browser saat start -> fresh (akun Google lama hilang)
RESET_PROFILE=false

# Mode headless (true = tanpa tampilan, false = kelihatan)
HEADLESS=false

# ---- Khusus flow.py (login dashboard + Google) ----
LOGIN_URL=http://38.47.85.35:20128/login
TARGET_URL=http://38.47.85.35:20128/dashboard/providers/antigravity
DASH_PASSWORD=Masuk123321
# File daftar akun Google, format per baris: gmail|password
ACCOUNTS_FILE=accounts.txt
REDIRECT_FROM=http://localhost:20128
REDIRECT_TO=http://38.47.85.35:20128
URL_LOG_FILE=urls.txt
# Bersihkan cookie Google tiap akun agar account chooser kosong (fix akun ke-2)
CLEAR_EACH=true
# Restart browser tiap akun (solusi VPS: close setelah 1 akun, buka baru untuk akun selanjutnya)
RESTART_BROWSER_PER_ACCOUNT=false
