# ============================================================
# Antigravity Auto - Config (.env)
# Salin file ini menjadi .env lalu isi nilai-nya
# IP:PORT disimpan di sini (LOGIN_URL, TARGET_URL, REDIRECT_*)
# ============================================================

# Dashboard 9Router
LOGIN_URL=http://38.47.85.35:20128/login
TARGET_URL=http://38.47.85.35:20128/dashboard/providers/antigravity
DASH_PASSWORD=Masuk123321

# OAuth redirect (localhost -> IP server via route rewrite)
REDIRECT_FROM=http://localhost:20128
REDIRECT_TO=http://38.47.85.35:20128

# Browser
USER_DATA_DIR=./browser_profile
RESET_PROFILE=false
HEADLESS=false
# true = tanpa tampilan (VPS), false = kelihatan (bisa handle verifikasi manual)

# Akun & log
ACCOUNTS_FILE=accounts.txt
URL_LOG_FILE=urls.txt

# Fix akun ke-2 (account chooser)
CLEAR_EACH=true
RESTART_BROWSER_PER_ACCOUNT=false

# Flask UI
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
